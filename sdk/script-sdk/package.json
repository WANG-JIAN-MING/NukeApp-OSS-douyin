  "bin": {
    "nuke-script": "bin/nuke-script.js"
  },
  "files": [
    "bin",
    "lib",
    "types",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.js\""
  },
  "peerDependencies": {
    "esbuild": ">=0.25.0"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    }
  }
}

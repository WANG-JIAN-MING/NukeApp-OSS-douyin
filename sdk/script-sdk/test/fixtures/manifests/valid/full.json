{
  "manifestVersion": 1,
  "apiVersion": 1,
  "id": "io.github.someone.auto-reply",
  "name": "Auto reply",
  "version": "2.1.0-beta",
  "versionCode": 210,
  "entry": "main.mjs",
  "description": "Answers messages while you are away.",
  "author": "someone",
  "homepage": "https://example.com/auto-reply",
  "hosts": ["com.ss.android.ugc.aweme"],
  "permissions": {
    "network": { "origins": ["https://api.example.com", "https://*.example.org:8443"], "privateNetwork": false },
    "java": true,
    "hook": true,
    "filesystem": { "host": true, "reason": "Reads the draft cache" },
    "host": ["douyin.messaging", "douyin.account"]
  }
}
